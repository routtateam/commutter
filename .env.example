# Copy to .env.local (git-ignored) and adjust.
# Base URL of the Routta backend REST API.
VITE_API_BASE_URL=http://localhost:4100/api/v1
# true = use the in-memory mock services (no backend needed); anything else = real HTTP calls.
VITE_USE_MOCKS=false

# Google Maps JavaScript API key — get one at https://console.cloud.google.com/google/maps-apis
# (enable "Maps JavaScript API", "Places API" and "Geocoding API"; restrict by HTTP referrer to
# this app's domain(s) plus http://localhost:5173 for dev). Wired into src/components/RouttaMap.tsx
# via @vis.gl/react-google-maps. Leave blank to keep the RouttaMapPlaceholder SVG (also used
# automatically if the SDK fails to load — bad key, billing/quota, no network).
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Cloud Console → Map Management, needed for AdvancedMarker's vector
# rendering in production. Defaults to Google's public "DEMO_MAP_ID" (fine for dev/testing, not
# for shipping) when unset.
VITE_GOOGLE_MAPS_MAP_ID=
